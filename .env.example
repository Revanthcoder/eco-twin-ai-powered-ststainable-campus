# EcoPulse AI — Campus Sustainability Intelligence Environment Configuration

# Express Backend & Digital Twin API Port
PORT=8000

# SQLite Database File Path (Default: server/data/campus.db)
DATABASE_FILE=server/data/campus.db

# Frontend API Connection URL (Default: http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# Optional Python AI Service Gateway URL (Default: http://127.0.0.1:8001)
AI_SERVICE_URL=http://127.0.0.1:8001

# Regional Grid Carbon Emission Factor (kg CO2e / kWh)
GRID_EMISSION_FACTOR=0.42

# Environment Mode
NODE_ENV=development
