# ─────────────────────────────────────────────
# EcoPulse AI — Campus Sustainability Intelligence
# .gitignore — React + Vite + Node.js Frontend
# ─────────────────────────────────────────────

# ──────────── Dependencies ────────────
node_modules/
.npm

# ──────────── Build Output ────────────
dist/
dist-ssr/
build/

# ──────────── Vite Cache & Temp ────────────
.vite/
*.local
vite.config.*.timestamp-*

# ──────────── Environment Variables ────────────
# Never commit secrets or API keys to version control
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ──────────── Editor / IDE ────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ──────────── OS Files ────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ──────────── Logs ────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────── Testing ────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ──────────── Misc ────────────
*.tgz
*.tar.gz
*.zip
.cache/
