# EcoNexus AI Microservice Environment Configuration
PORT=8001
HOST=0.0.0.0
DEMO_MODE=false

# LLM Configuration
# Options: mock | gemini | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL_NAME=gemini-1.5-flash

# Optional API Keys for Live Cloud LLM Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Computer Vision Optional Custom ONNX Weights
VISION_MODEL_PATH=models/vision_model.onnx
